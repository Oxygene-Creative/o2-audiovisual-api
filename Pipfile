[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
torch = {version="*", index="pytorch"}
torchvision = {version="*", index="pytorch"}
torchaudio = {version="*", index="pytorch"}
tensorflow = {version = "==2.12.0"}
fastapi = "*"
langchain = "*"
langchain-google-genai = "*"
sentence-transformers = "*"
pydub = "*"
google-auth = "*"
google-cloud-storage = "*"
elasticsearch = "*"
python-dotenv = "*"
uvicorn = "*"
transformers = {version = "==4.4.2"}
fuzzywuzzy = "*"
python-levenshtein = "*"
faster-whisper = "*"
huggingface-hub = "*"
mediapipe = "*"
inaspeechsegmenter = "*"
bertopic = "*"
langchain-text-splitters = "*"
pandas = "*"
moviepy = "*"
scikit-learn = "*"
zstandard = "*"

[dev-packages]
pytest = "*"
pytest-mock = "*"

[requires]
python_version = "3.10"
